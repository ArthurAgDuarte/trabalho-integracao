# Copie para .env e troque as senhas:  cp .env.example .env   (Windows: copy .env.example .env)
# O .env real NUNCA deve ser commitado (já está no .gitignore).
# O mesmo .env serve para esta API (Node.js) e para a versão Python.

# --- MQTT (Mosquitto) ---
# Usuário/senha que o ESP32, a API e o simulador usam para se conectar ao broker.
# No Docker, o serviço mosquitto gera o arquivo de senhas a partir destes dois valores.
MQTT_USER=gas
MQTT_PASSWORD=troque-esta-senha-mqtt
MQTT_PORT=1883
MQTT_TOPICO=casa/+/gas
# Host do broker visto pela API. No Docker é o nome do serviço; rodando local, use localhost.
MQTT_HOST=mosquitto
# Fixo de propósito (sessão persistente no broker). Não rode duas APIs com o mesmo id,
# nem a versão Python e a Node ao mesmo tempo.
MQTT_CLIENT_ID=api-gas

# --- Banco de dados ---
POSTGRES_USER=gas
POSTGRES_PASSWORD=troque-esta-senha-postgres
POSTGRES_DB=gas
# Mesmo usuário, senha e banco de cima. No Docker o host é "postgres"; rodando local, use localhost.
# O prefixo postgresql+psycopg:// é o formato da versão Python; esta API aceita ele e postgresql://.
# Se a senha tiver caracteres especiais (@ : / ? #), codifique-os aqui (ex.: @ vira %40).
DATABASE_URL=postgresql+psycopg://gas:troque-esta-senha-postgres@postgres:5432/gas

# --- Alertas ---
# Intervalo mínimo entre lembretes de um vazamento contínuo.
ALERTA_COOLDOWN_SEGUNDOS=300
# log = só registra no log | telegram = envia pelo TelegramNotificador
NOTIFICADOR=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO

# --- Opcional (só nesta versão) ---
# Interface onde a API escuta (porta 8000). Padrão 0.0.0.0 = toda a rede.
# API_HOST=127.0.0.1

# --- Simulador (tools/simulador.ts) ---
# IP da máquina onde o broker está rodando.
SIMULADOR_HOST=localhost
