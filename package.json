{
  "name": "deteccao-gas-api",
  "version": "1.0.0",
  "description": "Backend do Sistema de Detecção e Alerta de Vazamento de Gás: consome o MQTT do ESP32, grava o histórico no PostgreSQL e dispara as notificações.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "simulador": "tsx tools/simulador.ts",
    "teste:integrado": "tsx tools/teste-integrado.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.7",
    "mqtt": "^5.16.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "glob": "^14.0.3"
  }
}
